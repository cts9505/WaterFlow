# =====================================================
# WaterFlow Server — Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# =====================================================

# ── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/waterflow_db?schema=public"

# ── JWT Secret (generate a random 64-char string) ────
JWT_SECRET="CHANGE_ME_to_a_random_64_char_string"

# ── Server ───────────────────────────────────────────
PORT=5001
NODE_ENV=production

# ── CORS — Frontend URL ─────────────────────────────
CLIENT_URL="https://waterflow.in"

# ── Kafka (optional — app falls back to SSE if unavailable) ──
KAFKA_BROKER="localhost:9092"
